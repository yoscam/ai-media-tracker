# --- Recommendations (optional; works without, using genre-based local matching) ---
# Any OpenAI-compatible endpoint. For OpenAI leave AI_BASE_URL unset.
# Ollama:     AI_BASE_URL=http://localhost:11434/v1  AI_API_KEY=ollama  AI_MODEL=llama3.1
# OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-4o-mini

# --- Metadata (optional) ---
# Enables movie + TV search. Accepts a TMDB v3 API key or a v4 read access token.
TMDB_API_KEY=

# --- Storage ---
# Where the SQLite database lives. Mount this directory as a volume.
DATA_DIR=./data
